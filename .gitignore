# ── Secrets / credentials ──
envs/
.env
.env.*
!.env.example

# ── User config / data ──
# In development the data folder is the repository root, so every file the app
# writes there has to be listed — lastfm-session.txt holds a live session key.
config.json
flagged-lyrics.json
translate-cache.json
lyrics-cache.json
stats-history.json
listening-history.json
window-state.json
lyrics-offsets.json
lastfm-session.txt
lastfm-queue.json
# The user's own yt-dlp override (Settings → Lyrics → YouTube captions).
/bin/

# ── Logs ──
logs/
src/logs/
*.log

# ── Dependencies / build ──
node_modules/
# yt-dlp, fetched at build time by scripts/fetch-ytdlp.mjs — a 17MB binary does
# not belong in git, and pinning one would ship a stale copy.
vendor/
dist/
dist-electron/
build/
/release/

# ── OS artifacts ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE artifacts ──
.vs/

# ── LRCLib SQLite database dumps (can be 100GB+) ──
# The drop folder is "LRCLIB Dump"; both spellings, since git only matches
# case-insensitively where core.ignorecase is on.
LRCLIB DUMP/
LRCLIB Dump/
*.sqlite3.gz
*.db

# ── Lyrics databases ──
# The dump is far too large, and the custom store holds whatever lyrics the user
# imported — licensed text that has no business in a public repository. The app
# creates an empty one on first run, so nothing needs seeding here.
*.sqlite3

# ── SQLite temporary files (WAL/SHM) ──
*.sqlite3-shm
*.sqlite3-wal

# ── Atomic-write temp files ──
*.tmp

# ── Agent worktrees and session state ──
# .claude/settings.json, hooks/ and skills/ are the shared project setup and are
# committed; what is personal or per-session stays out.
.claude/settings.local.json
.claude/worktrees/
.claude/*.local.*

# ── Cloudflare Worker build cache ──
.wrangler/

# ── Windows shortcuts that wander into the working tree ──
*.lnk

# ── Renderer test harness (generated; never packaged) ──
harness/
