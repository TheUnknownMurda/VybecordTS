{
  "manifest_version": 3,
  "name": "Vybecord",
  "version": "2.6.0",
  "description": "Sends what you play on Spotify, YouTube, Twitch, Netflix, Disney+, Crunchyroll and other music and video sites to the Vybecord app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vybecord@theunknownmurda.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": ["authenticationInfo"]
      }
    }
  },
  "background": { "service_worker": "src/background.js" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "action": {
    "default_popup": "src/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8888/*"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["src/gm-shim.js", "src/sites/spotify.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["src/gm-shim.js", "src/sites/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["src/gm-shim.js", "src/sites/soundcloud.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.bandcamp.com/*"],
      "js": ["src/gm-shim.js", "src/sites/bandcamp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/gm-shim.js", "src/sites/twitch.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://kick.com/*"],
      "js": ["src/gm-shim.js", "src/sites/kick.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://www.amazon.com/*gp/video/*",
        "https://www.amazon.com/*dp/*",
        "https://www.amazon.ca/*gp/video/*",
        "https://www.amazon.ca/*dp/*",
        "https://www.amazon.co.uk/*gp/video/*",
        "https://www.amazon.co.uk/*dp/*",
        "https://www.amazon.de/*gp/video/*",
        "https://www.amazon.de/*dp/*",
        "https://www.amazon.fr/*gp/video/*",
        "https://www.amazon.fr/*dp/*",
        "https://www.amazon.it/*gp/video/*",
        "https://www.amazon.it/*dp/*",
        "https://www.amazon.es/*gp/video/*",
        "https://www.amazon.es/*dp/*",
        "https://www.amazon.co.jp/*gp/video/*",
        "https://www.amazon.co.jp/*dp/*",
        "https://www.amazon.com.br/*gp/video/*",
        "https://www.amazon.com.br/*dp/*",
        "https://www.amazon.com.mx/*gp/video/*",
        "https://www.amazon.com.mx/*dp/*",
        "https://www.amazon.com.au/*gp/video/*",
        "https://www.amazon.com.au/*dp/*",
        "https://www.amazon.in/*gp/video/*",
        "https://www.amazon.in/*dp/*"
      ],
      "js": ["src/gm-shim.js", "src/sites/primevideo.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["src/gm-shim.js", "src/sites/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["src/gm-shim.js", "src/film-page.js", "src/sites/disneyplus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.paramountplus.com/*"],
      "js": ["src/gm-shim.js", "src/film-page.js", "src/sites/paramountplus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tv.apple.com/*"],
      "js": ["src/gm-shim.js", "src/film-page.js", "src/sites/appletv.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crave.ca/*"],
      "js": ["src/gm-shim.js", "src/film-page.js", "src/sites/crave.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["src/gm-shim.js", "src/film-page.js", "src/sites/crunchyroll.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://static.crunchyroll.com/*"],
      "js": ["src/film-page.js", "src/sites/crunchyroll-player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.amazon.com/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.de/*",
        "https://music.amazon.fr/*",
        "https://music.amazon.it/*",
        "https://music.amazon.es/*",
        "https://music.amazon.co.jp/*",
        "https://music.amazon.com.br/*",
        "https://music.amazon.com.mx/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.in/*"
      ],
      "js": ["src/gm-shim.js", "src/sites/amazonmusic.js"],
      "run_at": "document_idle"
    }
  ]
}
