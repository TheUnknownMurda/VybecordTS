{
  "version": 2,
  "name": "vybecordts-website",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/download",
      "status": 302,
      "headers": {
        "Location": "https://github.com/TheUnknownMurda/VybecordTS/releases/latest"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
